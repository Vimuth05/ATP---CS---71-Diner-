        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\ntitle: Group Dining Session\n---\nsequenceDiagram\n  actor Host as Host Customer\n  actor Member as Group Member\n  participant App as Mobile App\n  participant API as Group Dining API\n  participant AI as AI Assistant\n  participant DB as Database\n\n  Host-&gt;&gt;App: Create group dining session\n  App-&gt;&gt;API: createGroup()\n  API-&gt;&gt;DB: Save group details\n  DB--&gt;&gt;API: Group ID and QR code\n  API--&gt;&gt;App: Display group QR code\n\n  Member-&gt;&gt;App: Scan group QR code\n  App-&gt;&gt;API: joinGroup(groupQR)\n  API-&gt;&gt;DB: Register group member\n  DB--&gt;&gt;API: Member added\n  API--&gt;&gt;App: Join successful\n\n  Host-&gt;&gt;App: Request group food recommendations\n  App-&gt;&gt;AI: getGroupRecommendations(groupId)\n  AI-&gt;&gt;DB: Fetch member preferences\n  DB--&gt;&gt;AI: Dietary needs, allergies, budgets\n  AI-&gt;&gt;AI: Analyse group preferences\n  AI--&gt;&gt;App: Recommend restaurants and food\n  App--&gt;&gt;Host: Display recommendations\n\n  Host-&gt;&gt;App: Select restaurant and food\n  App-&gt;&gt;API: Confirm group order\n  API-&gt;&gt;DB: Save group order\n  DB--&gt;&gt;API: Order confirmed\n  API--&gt;&gt;App: Display confirmation&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="2">
