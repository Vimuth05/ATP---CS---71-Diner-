        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\ntitle: Restaurant Analytics Dashboard\n---\nsequenceDiagram\n  actor Owner as Restaurant Owner\n  participant Web as Restaurant Web App\n  participant API as Analytics API\n  participant DB as Database\n  participant AI as AI Analytics Engine\n\n  Owner-&gt;&gt;Web: Login\n  Web-&gt;&gt;API: authenticateOwner(credentials)\n  API-&gt;&gt;DB: Verify owner account\n  DB--&gt;&gt;API: Authentication result\n  API--&gt;&gt;Web: Login successful\n\n  Owner-&gt;&gt;Web: Open dashboard\n  Web-&gt;&gt;API: getMonthlyAnalytics()\n  API-&gt;&gt;DB: Fetch orders and payments\n  DB--&gt;&gt;API: Sales and payment records\n  API-&gt;&gt;AI: analyseRestaurantData(records)\n  AI-&gt;&gt;AI: Calculate sales trends\n  AI-&gt;&gt;AI: Identify fast-selling items\n  AI-&gt;&gt;AI: Analyse revenue and performance\n  AI-&gt;&gt;AI: Generate business suggestions\n  AI--&gt;&gt;API: Analytics and recommendations\n  API--&gt;&gt;Web: Return dashboard data\n  Web--&gt;&gt;Owner: Display monthly sales and insights\n\n  Owner-&gt;&gt;Web: View business recommendations\n  Web--&gt;&gt;Owner: Display AI suggestions&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="JM-2oJCfAYv7xqZhK_rX-1">
